{
 "citation": {
  "CASE_CAPTION": {
   "example": "Smith v. Jones",
   "groups": [],
   "pattern": "\\b[A-Z][\\w.&'-]+\\s+v\\.?s?\\.?\\s+[A-Z][\\w.&'-]+",
   "weight": 0.7
  },
  "CFR": {
   "example": "29 C.F.R. 1630.2",
   "groups": [
    "title",
    "section"
   ],
   "pattern": "\\b(\\d{1,2})\\s+C\\.?\\s?F\\.?\\s?R\\.?\\s*(?:§+\\s*)?(\\d+(?:\\.\\d+)?)\\b",
   "weight": 1.0
  },
  "DOCKET_NUMBER": {
   "example": "No. 21-1234",
   "groups": [
    "docket"
   ],
   "pattern": "\\b(?:Case\\s+|Docket\\s+)?No\\.\\s*(\\d{1,2}[:-][a-z]{2}-\\d{2,6}|\\d{2}-\\d{1,6})\\b",
   "weight": 0.8
  },
  "FEDERAL_REPORTER": {
   "example": "500 F.3d 100",
   "groups": [
    "volume",
    "page"
   ],
   "pattern": "\\b(\\d{1,3})\\s+F\\.?\\s?(?:2d|3d|4th)\\s+(\\d{1,4})\\b",
   "weight": 1.0
  },
  "FEDERAL_SUPPLEMENT": {
   "example": "900 F. Supp. 2d 12",
   "groups": [
    "volume",
    "page"
   ],
   "pattern": "\\b(\\d{1,3})\\s+F\\.?\\s?Supp\\.?(?:\\s?[23]d)?\\s+(\\d{1,4})\\b",
   "weight": 1.0
  },
  "PUBLIC_LAW": {
   "example": "Pub. L. 111-148",
   "groups": [
    "congress",
    "number"
   ],
   "pattern": "\\bPub\\.?\\s?L\\.?\\s+(?:No\\.\\s+)?(\\d{2,3})-(\\d+)\\b",
   "weight": 1.0
  },
  "SECTION_SYMBOL": {
   "example": "§ 1983",
   "groups": [
    "section"
   ],
   "pattern": "§+\\s*(\\d+[\\w.\\-]*)",
   "weight": 0.7
  },
  "STATE_REPORTER": {
   "example": "16 Cal.App.4th 943",
   "groups": [
    "volume",
    "page"
   ],
   "pattern": "\\b(\\d{1,3})\\s+(?:Cal\\.?(?:\\s?App\\.?)?(?:\\s?(?:[2-5]th|[23]d))?|N\\.?Y\\.?(?:\\s?[23]d)?|Ill\\.?(?:\\s?[23]d)?|So\\.?\\s?[23]d|N\\.?E\\.?\\s?[23]d|N\\.?W\\.?\\s?[23]d|S\\.?W\\.?\\s?[23]d|P\\.?\\s?[23]d|A\\.?\\s?[23]d)\\s+(\\d{1,4})\\b",
   "weight": 1.0
  },
  "SUPREME_COURT_REPORTER": {
   "example": "123 S. Ct. 456",
   "groups": [
    "volume",
    "page"
   ],
   "pattern": "\\b(\\d{1,3})\\s+S\\.?\\s?Ct\\.?\\s+(\\d{1,4})\\b",
   "weight": 1.0
  },
  "USC": {
   "example": "42 U.S.C. 1983",
   "groups": [
    "title",
    "section"
   ],
   "pattern": "\\b(\\d{1,2})\\s+U\\.?\\s?S\\.?\\s?C\\.?\\s*(?:A\\.?\\s*)?(?:§+\\s*)?(\\d+[a-z]?)\\b",
   "weight": 1.0
  },
  "US_REPORTS": {
   "example": "347 U.S. 483",
   "groups": [
    "volume",
    "page"
   ],
   "pattern": "\\b(\\d{1,3})\\s+U\\.?\\s?S\\.?\\s+(\\d{1,4})\\b",
   "weight": 1.0
  }
 },
 "conceptual": {
  "FACT_PATTERN": {
   "pattern": "\\b(employer|employee|landlord|tenant|contract breach|accident|negligence|harassment|discrimination)\\b",
   "weight": 0.6
  },
  "INTERPRETATION": {
   "pattern": "\\b(interpretation|meaning|scope|application|applicability|implication|effect)\\s+of\\b",
   "weight": 0.7
  },
  "LEGAL_CONCEPTS": {
   "pattern": "\\b(due process|equal protection|doctrine of\\s+\\w+|principle of\\s+\\w+|right to\\s+\\w+|test of\\s+\\w+|burden of proof)\\b",
   "weight": 0.7
  },
  "QUESTION_WORDS": {
   "pattern": "\\b(what|when|where|who|why|how|can|does|is|are|was|were)\\b",
   "weight": 0.8
  }
 },
 "hierarchical": {
  "COURT_FILTER": {
   "pattern": "\\b(Supreme Court|Court of Appeals|Circuit Court|District Court|Bankruptcy Court|Court of Federal Claims|Tax Court|[1-9]th Circuit|D\\.C\\. Circuit|Federal Circuit)\\b",
   "weight": 0.8
  },
  "COURT_LEVEL": {
   "pattern": "\\b(highest court|appellate court|trial court|intermediate appellate|federal court|state court)\\b",
   "weight": 0.7
  },
  "COURT_WITH_CASES": {
   "pattern": "\\b(Supreme Court|Court of Appeals|District Court|Circuit)\\s+(?:cases?|decisions?|opinions?|rulings?|precedents?)\\b",
   "weight": 0.9
  },
  "DATE_RANGE": {
   "pattern": "\\b(?:between|from|since|after|before|during)\\s+(?:19|20)\\d{2}(?:\\s+(?:and|to|through)\\s+(?:19|20)\\d{2})?\\b",
   "weight": 0.8
  },
  "JUDGE_FILTER": {
   "pattern": "\\b(?:Judge|Justice|Chief Justice)\\s+[A-Z][a-z]+",
   "weight": 0.5
  },
  "JURISDICTION_FILTER": {
   "pattern": "\\b(?:in|under)\\s+(?:federal|state)\\s+(?:law|court)\\b",
   "weight": 0.7
  },
  "TITLE_FILTER": {
   "pattern": "\\b(?:Title\\s+\\d{1,2})\\s+(?:of the\\s+)?(?:U\\.?S\\.?\\s?Code|C\\.?F\\.?R\\.?|United States Code)\\b",
   "weight": 0.8
  },
  "YEAR_MENTION": {
   "pattern": "\\b(?:19|20)\\d{2}\\b",
   "weight": 0.6
  }
 }
}
