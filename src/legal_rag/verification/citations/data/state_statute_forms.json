{
  "description": "State statute citation forms. Each form has an id, a two letter state code, a regular expression with named groups, and a template that renders the normalized citation from those groups.",
  "forms": [
    {
      "id": "il_ilcs",
      "state": "il",
      "pattern": "\\b(?P<chapter>\\d{1,3})\\s+ILCS\\s+(?P<act>\\d{1,4})\\s*/\\s*(?P<section>\\d[\\w\\-]*(?:\\.\\d[\\w\\-]*)*)",
      "template": "{chapter} ILCS {act}/{section}"
    },
    {
      "id": "wa_rcw",
      "state": "wa",
      "pattern": "\\bRCW\\s+(?P<section>\\d{1,2}[A-Z]?\\.\\d+[A-Z]?\\.\\d+[\\w\\-]*)",
      "template": "RCW {section}"
    },
    {
      "id": "nv_nrs",
      "state": "nv",
      "pattern": "\\bNRS\\s+(?P<section>\\d{1,3}[A-Z]?\\.\\d+[\\w\\-]*)",
      "template": "NRS {section}"
    },
    {
      "id": "nv_rev_stat",
      "state": "nv",
      "pattern": "\\bNev\\.\\s*Rev\\.\\s*Stat\\.\\s*(?:Ann\\.\\s*)?(?:§§?\\s*)?(?P<section>\\d{1,3}[A-Z]?\\.\\d+[\\w\\-]*)",
      "template": "Nev. Rev. Stat. § {section}"
    },
    {
      "id": "de_code",
      "state": "de",
      "pattern": "\\b(?P<title>\\d{1,2})\\s+Del\\.\\s*C\\.\\s*(?:Ann\\.\\s*)?(?:§§?\\s*)?(?P<section>\\d[\\w\\-]*(?:\\.\\d[\\w\\-]*)*)",
      "template": "{title} Del. C. § {section}"
    },
    {
      "id": "ca_code",
      "state": "ca",
      "pattern": "\\bCal\\.\\s*(?P<code>Civ|Penal|Pen|Gov|Lab|Bus\\.?\\s*&\\s*Prof|Corp|Fam|Evid|Health\\s*&\\s*Safety|Ins|Prob|Veh|Educ)\\.?\\s*(?:Code\\s*)?(?:§§?\\s*)(?P<section>\\d[\\w\\-]*(?:\\.\\d[\\w\\-]*)*)",
      "template": "Cal. {code} Code § {section}",
      "code_names": {
        "civ": "Civ.",
        "penal": "Penal",
        "pen": "Pen.",
        "gov": "Gov.",
        "lab": "Lab.",
        "busprof": "Bus. & Prof.",
        "corp": "Corp.",
        "fam": "Fam.",
        "evid": "Evid.",
        "healthsafety": "Health & Safety",
        "ins": "Ins.",
        "prob": "Prob.",
        "veh": "Veh.",
        "educ": "Educ."
      }
    },
    {
      "id": "ny_consolidated",
      "state": "ny",
      "pattern": "\\bN\\.Y\\.\\s*(?P<code>[A-Z][A-Za-z.&\\s]{2,30}?)\\s*(?:Law|Law\\s+Ann\\.)\\s*(?:§§?\\s*)(?P<section>\\d[\\w\\-]*(?:\\.\\d[\\w\\-]*)*)",
      "template": "N.Y. {code} Law § {section}"
    },
    {
      "id": "tx_code",
      "state": "tx",
      "pattern": "\\bTex\\.\\s*(?P<code>Penal|Civ\\.\\s*Prac\\.\\s*&\\s*Rem\\.|Bus\\.\\s*&\\s*Com\\.|Fam\\.|Gov't|Lab\\.|Prop\\.)\\s*Code\\s*(?:Ann\\.\\s*)?(?:§§?\\s*)(?P<section>\\d[\\w\\-]*(?:\\.\\d[\\w\\-]*)*)",
      "template": "Tex. {code} Code § {section}",
      "code_names": {}
    },
    {
      "id": "fl_stat",
      "state": "fl",
      "pattern": "\\bFla\\.\\s*Stat\\.\\s*(?:Ann\\.\\s*)?(?:§§?\\s*)?(?P<section>\\d{1,3}\\.\\d+[\\w\\-]*)",
      "template": "Fla. Stat. § {section}"
    }
  ]
}
