{
  "version": 1,
  "default_packs": [
    "us"
  ],
  "packs": {
    "us": {
      "description": "United States agency guidance and notices. Active by default.",
      "classification": {
        "circular": [
          [
            "FEDERAL REGISTER",
            0.8,
            "i"
          ],
          [
            "^AGENCY\\s*:",
            0.8,
            "mi"
          ],
          [
            "^ACTION\\s*:\\s*(?:NOTICE|FINAL RULE|PROPOSED RULE)",
            0.9,
            "mi"
          ],
          [
            "\\bDOCKET NO\\.?",
            0.6,
            "i"
          ],
          [
            "(?:BULLETIN|ADVISORY|INFORMATION LETTER) NO\\.?",
            0.85,
            "i"
          ],
          [
            "DEAR (?:COLLEAGUE|CHIEF EXECUTIVE|MEMBER)",
            0.8,
            "i"
          ]
        ],
        "regulatory": [
          [
            "CODE OF FEDERAL REGULATIONS",
            0.85,
            "i"
          ],
          [
            "\\d+\\s+C\\.F\\.R\\.\\s+(?:PART|\u00a7)",
            0.8,
            "i"
          ],
          [
            "NO-ACTION LETTER",
            0.9,
            "i"
          ]
        ]
      }
    },
    "india": {
      "description": "Court and regulator conventions used in Indian documents. Opt in with jurisdictions=['us', 'india'].",
