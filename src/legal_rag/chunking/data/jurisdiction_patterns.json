        "judgment": [
          [
            "(?:CIVIL|CRIMINAL) APPEAL NO\\.",
            0.8,
            "i"
          ],
          [
            "WRIT PETITION",
            0.7,
            "i"
          ],
          [
            "SPECIAL LEAVE PETITION",
            0.8,
            "i"
          ],
          [
            "HON'?BLE\\s+(?:MR\\.|MS\\.|MRS\\.)?\\s*JUSTICE",
            0.8,
            "i"
          ],
          [
            "CORAM\\s*:",
            0.7,
            "i"
          ]
        ],
        "regulatory": [
          [
            "SEBI\\s*\\([^)]+\\)\\s*REGULATIONS",
            0.98,
            "i"
          ],
          [
            "SEBI (?:CIRCULAR|NOTIFICATION|ORDER)",
            0.95,
            "i"
          ],
          [
            "REGULATION\\s+\\d+(?:\\s+OF\\s+SEBI)?",
            0.85,
            "i"
          ],
          [
            "RBI (?:CIRCULAR|MASTER DIRECTION|NOTIFICATION)",
            0.95,
            "i"
          ],
          [
            "CIRCULAR NO\\.?\\s*[A-Z]+[/-]?\\d+",
            0.8,
            "i"
          ],
          [
            "(?:GST|INCOME TAX) (?:NOTICE|ORDER|DEMAND)",
            0.85,
            "i"
          ]
        ],
        "circular": [
          [
            "(?:RBI|SEBI|IRDA|PFRDA)\\s*/\\s*\\d{4}",
            0.98,
            "i"
          ],
          [
            "(?:RBI|SEBI|IRDA|PFRDA) (?:CIRCULAR|NOTIFICATION)",
            0.98,
            "i"
          ],
          [
            "RESERVE BANK OF INDIA",
            0.95,
            "i"
          ],
          [
            "SECURITIES AND EXCHANGE BOARD",
            0.95,
            "i"
          ],
          [
            "GAZETTE (?:NOTIFICATION|OF INDIA)",
            0.95,
            "i"
          ],
          [
